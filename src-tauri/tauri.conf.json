{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GVM Trampolin",
  "version": "1.2.0",
  "identifier": "de.karlsruher-turngau.gvm-trampolin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GVM Trampolin",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Auswertung Gau-Vereinsmeisterschaften Trampolin",
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDRkI4NThENEYyQkYxMTIKUldRUzhTdFBqWVg3ckF4TWYwZnRWNjA4SXY0OElaY1ZrL1pwb1QvZ1BTOXc1YjBhQlNqdkgvNm8K",
      "endpoints": [
        "https://github.com/Lukas-sys/GAU-Meisterschaften-Trampolin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
